# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PLATFORM_ADMIN_EMAILS=founder@example.com

# Database
# Runtime should use the pooled Supabase/Postgres URL when deployed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=public
# Migrations should use the direct database URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

# Stripe subscriptions and credit packs
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_BASIC_MONTHLY=price_replace_me
STRIPE_PRICE_BASIC_YEARLY=price_replace_me
STRIPE_PRICE_PRO_MONTHLY=price_replace_me
STRIPE_PRICE_PRO_YEARLY=price_replace_me
STRIPE_PRICE_BUSINESS_MONTHLY=price_replace_me
STRIPE_PRICE_BUSINESS_YEARLY=price_replace_me
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_replace_me
STRIPE_PRICE_CREDIT_PACK_100=price_replace_me

# AI
GOOGLE_GENERATIVE_AI_API_KEY=replace-me
FIRECRAWL_API_KEY=replace-me

# Transactional email via ZeptoMail
ZEPTOMAIL_API_URL=api.zeptomail.com/
ZEPTO_MAIL_API_KEY=Zoho-enczapikey replace-me
EMAIL_FROM=noreply@qtable.ai
EMAIL_FROM_NAME=Qtable
# Random 16+ character secret used to authenticate scheduled analytics delivery.
CRON_SECRET=replace-with-a-long-random-string

# Cloudflare R2 uploads
CLOUDFLARE_BUCKET_API=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=replace-me
CLOUDFLARE_SECRET_ACCESS_KEY=replace-me
CLOUDFLARE_BUCKET_NAME=qtable-assets
CLOUDFLARE_PUBLIC_URL=https://files.qtable.ai
